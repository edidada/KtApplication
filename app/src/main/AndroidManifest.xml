<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      权限按"链路"而不是"功能"分组声明，注释里写清每一组的必要性来源，
      车机上提测时安全评审要逐条对齐（多余的权限会直接被拒）。

      1) 车联网：远程车况 + 远程控车走 TSP，HTTPS 出网必须有 INTERNET；
         ACCESS_NETWORK_STATE 用于把"云端离线"如实标进 signalHealth，
         而不是让 UI 显示一个 3 分钟前的值假装在线。
      2) 座舱蓝牙：Android 12 起运行时权限拆成 BLUETOOTH_CONNECT，
         旧平台仍用 BLUETOOTH/BLUETOOTH_ADMIN，因此用 maxSdkVersion 双声明；
         这里只读 profile 连接状态（A2DP/HFP），不做扫描，所以不需要
         BLUETOOTH_SCAN 与位置权限。
      3) 车载系统权限（CAR_PROPERTY / CAR_ELECTRONIC_CONTROL_UNIT 等）由 OEM
         以 signature|privileged 下发，必须在平台签名构建里加，本地示例不声明。
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      后台保活：座舱 App 的常驻能力来自车机白名单与系统签名，不是自己起前台服务。
      如果确实要走 FGS（例如车外远程控车需要常驻监听推送），下面两行与
      AppGraph.declaredForegroundServiceTypes 必须同时打开，否则
      KeepAliveInspector 会把"声明与实际不符"报成风险项。

      <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
      <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    -->

    <!-- 车机通常没有 GPS 芯片给 App 直用，定位优先走 CarService/整车 TBOX；本地无 GNSS 时不声明。 -->
    <!-- <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" /> -->

    <application
        android:name=".CockpitApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KtApplication">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.KtApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
